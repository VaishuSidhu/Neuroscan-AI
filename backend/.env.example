# NeuroScan AI Environment Variables

# DATABASE CONFIGURATION
# For Local SQLite: sqlite:///../database/brain_tumor.db
# For PostgreSQL (Render): postgresql://user:password@hostname/dbname
DATABASE_URL=sqlite:///../database/brain_tumor.db

# AUTHENTICATION
# Do NOT commit real secrets to version control. Generate a random secure key.
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI PIPELINE
# Set to 'production' to load real PyTorch weights. 
# Keep as 'demo' for free-tier deployments (bypasses heavy ML models).
AI_MODE=demo
CLASSIFIER_MODEL_PATH=../models/brain_tumor_classifier.pth
SEGMENTATION_MODEL_PATH=../models/brain_tumor_unet.pth

# CORS (Cross-Origin Resource Sharing)
# For Render, add your frontend URL (e.g. https://neuroscan-ui.onrender.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
